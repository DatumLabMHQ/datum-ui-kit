#!/usr/bin/env python3
"""The Datum UI kit's two commands.

    bin/datum-ui new <slug> [--kind app|site] [--title ...] [--description ...]
    bin/datum-ui sync <slug> [--dry-run]

`new` copies templates/app into ~/<slug>, fills the name and drops the shell you did not ask for.
`sync` copies the kit's own files forward into a project built with it and lists what changed; it
never touches a project's own pages, components or config.
"""
import argparse, os, re, shutil, sys
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent
ROOT = Path(os.environ.get('DATUM_ROOT', Path.home()))
TEMPLATE = KIT / 'templates' / 'app'

def slugify(s):
    s = re.sub(r'[^a-z0-9-]+', '-', s.lower()).strip('-')
    if not s: sys.exit('slug must have letters or numbers in it')
    return s

# Kit files: changed in the kit and copied forward into every project (docs/UI.md ยง8). Everything else
# in a project is its own. `datum-ui sync <slug>` copies these, reports what changed, and touches
# nothing else.
KIT_FILES = [
    'app/globals.css', 'app/layout.tsx', 'app/not-found.tsx',
    'app/(app)/layout.tsx', 'app/(app)/loading.tsx', 'app/(app)/error.tsx', 'app/(app)/not-found.tsx',
    'app/(site)/layout.tsx',
    'components/Providers.tsx', 'components/ThemeToggle.tsx', 'components/app-sidebar.tsx', 'components/card-row.tsx',
    'components/command-menu.tsx', 'components/data-table.tsx', 'components/detail-layout.tsx', 'components/page-breadcrumb.tsx',
    'components/page-header.tsx', 'components/rule.tsx', 'components/site-footer.tsx', 'components/site-header.tsx',
    'components/brand-mark.tsx', 'lib/brand.ts',
    'lib/format.ts', 'lib/nav.ts', 'lib/utils.ts', 'hooks/use-mobile.ts',
    'tests/smoke.spec.ts', 'playwright.config.ts', '.github/workflows/check.yml',
    'components.json', 'eslint.config.mjs', 'postcss.config.mjs', 'next.config.ts', 'tsconfig.json',
]
KIT_DIRS = ['components/ui', 'public/brand']
IGNORE = shutil.ignore_patterns('node_modules', '.next', '.vercel', 'next-env.d.ts', 'tsconfig.tsbuildinfo', '.env*', 'test-results', 'playwright-report')

def kit_file_list():
    files = list(KIT_FILES)
    for d in KIT_DIRS:
        files += [str(p.relative_to(TEMPLATE)) for p in (TEMPLATE / d).rglob('*') if p.is_file()]
    return files

def new(a):
    slug = slugify(a.slug)
    title = a.title or slug.replace('-', ' ').title()
    description = a.description or f'{title}, an internal tool by Datum Labs.'
    dest = ROOT / slug
    if dest.exists() and any(dest.iterdir()): sys.exit(f'{dest} exists and is not empty')
    shutil.copytree(TEMPLATE, dest, ignore=IGNORE)

    # The name goes in three places; everything else reads from site.config.ts.
    cfg = dest / 'site.config.ts'
    cfg.write_text(cfg.read_text().replace('{{title}}', title).replace('{{description}}', description))
    pkg = dest / 'package.json'
    pkg.write_text(pkg.read_text().replace('"name": "datum-ui-template"', f'"name": "{slug}"'))

    # Keep one shell. The gallery pages are the kit's own; a new project starts with a home page.
    gallery = ['app/(app)/foundations', 'app/(app)/components', 'app/(app)/patterns', 'components/demos']
    if not a.keep_gallery:
        for p in gallery: shutil.rmtree(dest / p, ignore_errors=True) if (dest / p).is_dir() else (dest / p).unlink(missing_ok=True)
        (dest / 'app/(app)/page.tsx').write_text(HOME.replace('{{title}}', title))
        cfg.write_text(re.sub(r"const NAV: NavEntry\[\] = \[.*?\n\];\n", NAV, cfg.read_text(), flags=re.S))
    if a.kind == 'site':
        shutil.rmtree(dest / 'app/(app)', ignore_errors=True)
        landing = dest / 'app/(site)/landing/page.tsx'
        if landing.exists():
            (dest / 'app/(site)/page.tsx').write_text(landing.read_text().replace("export const metadata = { title: 'Landing page' };\n\n", ''))
            shutil.rmtree(dest / 'app/(site)/landing', ignore_errors=True)
    else:
        if not a.keep_gallery: shutil.rmtree(dest / 'app/(site)', ignore_errors=True)

    print(f'{title} -> {dest}\n'
          f'next: cd {dest} && npm install && npm run dev\n'
          f'      edit site.config.ts, then add pages under app/\n'
          f'      the rules are in {KIT}/docs/UI.md, the live gallery is `npm run dev` in {TEMPLATE}')

NAV = """const NAV: NavEntry[] = [
  { href: '/', label: 'Overview', icon: 'home' },
];
"""

HOME = """import { PageHeader } from '@/components/page-header';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

export default function Home() {
  return (
    <>
      <PageHeader eyebrow="Overview" question="What question does this page answer?"
        answer="Replace this line with the answer, in one sentence, including the number that matters and when it was taken." />
      <div className="px-4 lg:px-6">
        <Card>
          <CardHeader>
            <CardTitle>{{title}}</CardTitle>
            <CardDescription>Every card says what it holds and why it matters. Delete this one and build the page.</CardDescription>
          </CardHeader>
          <CardContent className="text-sm text-muted-foreground">
            Add pages under app/(app)/ and list them in site.config.ts. Run the kit&rsquo;s gallery beside this app to copy components and patterns.
          </CardContent>
        </Card>
      </div>
    </>
  );
}
"""

def sync(a):
    slug = slugify(a.slug); dest = ROOT / slug
    if not dest.exists(): sys.exit(f'{dest} does not exist')
    changed, added = [], []
    # A project keeps one shell; sync updates what it has and never puts back a shell it dropped.
    optional = [d for d in ('app/(site)', 'app/(app)') if not (dest / d).exists()]
    for rel in kit_file_list():
        src, dst = TEMPLATE / rel, dest / rel
        if not src.exists() or any(rel.startswith(o + '/') for o in optional): continue
        if not dst.exists(): added.append(rel)
        elif src.read_bytes() != dst.read_bytes(): changed.append(rel)
        else: continue
        if not a.dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
    for rel in changed: print(f'  ~ {rel}')
    for rel in added: print(f'  + {rel}')
    if not changed and not added: print('  already in step with the kit')
    elif a.dry_run: print(f'{len(changed) + len(added)} file(s) would change (--dry-run)')
    else: print(f'{len(changed) + len(added)} file(s) copied into {dest}\nnext: cd {dest} && npm run check   (then review the diff and commit)')

p = argparse.ArgumentParser(prog='datum-ui', description='The Datum UI kit: start a project, keep it in step.')
sub = p.add_subparsers(dest='cmd', required=True)
n = sub.add_parser('new', help='start a project from the kit')
n.add_argument('slug'); n.add_argument('--kind', choices=['app', 'site'], default='app', help='app: the sidebar shell. site: the wide shell, no sidebar.')
n.add_argument('--title'); n.add_argument('--description')
n.add_argument('--keep-gallery', action='store_true', help='keep the foundations, components and patterns pages in the new project')
n.set_defaults(fn=new)
s = sub.add_parser('sync', help='copy the kit files forward into a project built with it')
s.add_argument('slug'); s.add_argument('--dry-run', action='store_true'); s.set_defaults(fn=sync)
a = p.parse_args(); a.fn(a)
